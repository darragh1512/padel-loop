# Padel Loop — environment variables.
# Copy to .env.local for local development. NEVER commit .env.local.
# The same values must also be set in the Vercel project settings.

# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── PostHog (product analytics) ──────────────────────────────────────────
# EU CLOUD ONLY. The app refuses to start PostHog against any other host,
# because sending EU users' data to the US would contradict the privacy
# policy. Create the project at eu.posthog.com, not us.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Sentry (error monitoring) ────────────────────────────────────────────
# EU REGION ONLY. An EU-region DSN contains ".ingest.de.sentry.io" — if yours
# says ".ingest.us.sentry.io" the project is in the US and needs recreating;
# Sentry cannot move a project between regions after it is made.
NEXT_PUBLIC_SENTRY_DSN=

# Build-time only — used to upload source maps so stack traces are readable.
# NOT public, and not needed to run the app locally. Set it in Vercel.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
